              "raw": "{\n  \"name\": \"Payment Flow Test\",\n  \"description\": \"Test payment processing flow for THY\",\n  \"project\": \"{{projectId}}\",\n  \"owner\": \"{{userId}}\",\n  \"visibility\": \"team\",\n  \"nodes\": [\n    {\n      \"id\": \"node-1\",\n      \"type\": \"custom\",\n      \"position\": {\n        \"x\": 100,\n        \"y\": 100\n      },\n      \"data\": {\n        \"label\": \"POST /payment/init\",\n        \"method\": \"POST\",\n        \"url\": \"https://api.thy.com/payment/init\",\n        \"headers\": {\n          \"Content-Type\": \"application/json\",\n          \"Authorization\": \"Bearer {{token}}\"\n        },\n        \"body\": {\n          \"amount\": 1000,\n          \"currency\": \"TRY\",\n          \"orderId\": \"ORDER-123\"\n        },\n        \"assertions\": [\n          {\n            \"type\": \"status\",\n            \"field\": \"status\",\n            \"operator\": \"equals\",\n            \"expected\": \"200\",\n            \"description\": \"Payment initialization should return 200\"\n          }\n        ],\n        \"timeout\": 30000,\n        \"retries\": 3\n      }\n    },\n    {\n      \"id\": \"node-2\",\n      \"type\": \"custom\",\n      \"position\": {\n        \"x\": 400,\n        \"y\": 100\n      },\n      \"data\": {\n        \"label\": \"GET /payment/status\",\n        \"method\": \"GET\",\n        \"url\": \"https://api.thy.com/payment/status/{{paymentId}}\",\n        \"headers\": {\n          \"Authorization\": \"Bearer {{token}}\"\n        },\n        \"assertions\": [\n          {\n            \"type\": \"body\",\n            \"field\": \"status\",\n            \"operator\": \"equals\",\n            \"expected\": \"completed\",\n            \"description\": \"Payment should be completed\"\n          }\n        ],\n        \"timeout\": 30000,\n        \"retries\": 3\n      }\n    }\n  ],\n  \"edges\": [\n    {\n      \"id\": \"edge-1\",\n      \"source\": \"node-1\",\n      \"target\": \"node-2\",\n      \"type\": \"default\",\n      \"animated\": true\n    }\n  ],\n  \"variables\": {\n    \"baseUrl\": \"https://api.thy.com\",\n    \"timeout\": \"30000\"\n  },\n  \"settings\": {\n    \"timeout\": 300000,\n    \"parallel\": false,\n    \"retryOnFailure\": true,\n    \"maxRetries\": 3\n  },\n  \"tags\": [\"payment\", \"thy\", \"critical\"]\n}"
